# Copy this file to .env. Replace private path and scheduler placeholders.
# Use shell syntax. Quote values. Never put credentials in this example.
# Exported HIP_*, HF_*, and FAIRCHEM_* settings override values in .env.

# Runtime and private project storage.
HIP_CLUSTER_ROOT="/path/to/private/project"
HIP_LOADER_PYTHON="/path/to/python/environment/bin/python"
HIP_PYTHON="$HIP_LOADER_PYTHON"
HIP_LOADER_PACKAGE="$PWD"
HIP_LOADER_EXTRAS=""
HIP_LOADER_UV="/path/to/uv"
HIP_STEP_SETUP=""  # Optional shell file for CUDA library setup.
HIP_STEP_CHECKPOINT="/path/to/teacher/checkpoint.pt"

# Training paths. Hyperparameters stay in versioned JSON configurations.
HIP_TRAIN_INDEX="/path/to/train_index.npz"
HIP_VALIDATION_INDEX="/path/to/validation_index.npz"
HIP_TRAIN_CONFIG="$PWD/configs/train.json"
HIP_TRAIN_OUTPUT="$PWD/outputs/training/balanced"
HIP_TRAIN_RUNTIME_PACKAGE=""  # Optional immutable package for checkpoint continuations.
HIP_TRAIN_RUNTIME_POINTER=""  # Optional private file with the current runtime directory on its first line.
HIP_TRAIN_EXECUTION_MODE=""  # Empty uses the JSON setting or the optimized float32 default.
HIP_CUDA_ALLOC_CONF="expandable_segments:True"  # Empty selects the default CUDA allocator.

# Scheduler settings. Change the partition for CPU jobs if required.
HIP_SLURM_ACCOUNT="your-account"
HIP_SLURM_PARTITION="your-gpu-partition"
HIP_SLURM_QOS=""
HIP_SLURM_TIME_LIMIT=""  # Optional scheduler wall time, e.g. 02:00:00.
HIP_SLURM_CPUS_PER_TASK="8"  # Main process and four loader workers.
HIP_SLURM_LOG_DIR="$PWD/outputs/slurm"

# Optional data preparation, benchmarks, and audits.
HIP_SHARDS="/path/to/training/shards"
HIP_ASSIGNMENTS="/path/to/training/assignments.npz"
HIP_LOADER_SOURCE="$HIP_SHARDS"
HIP_LOADER_ASSIGNMENTS="$HIP_ASSIGNMENTS"
HIP_LOADER_CACHE="/path/to/private/benchmark/cache"
HIP_LOADER_REPORT="$PWD/outputs/loader/report.json"
HIP_STEP_REPORT="$PWD/outputs/benchmark/report.json"
HIP_RANDOMNESS_INDEX="$HIP_TRAIN_INDEX"
HIP_BATCH_INDEX="/path/to/representative/index.npz"
HIP_READINESS_OUTPUT="$PWD/outputs/readiness"
HIP_LOCAL_CACHE_PARENT="${SLURM_TMPDIR:-${TMPDIR:-/tmp}}"
HIP_E2E_PREPARE=""  # Optional private preparation script.
HIP_SPEED_CONFIG="$HIP_TRAIN_CONFIG"
HIP_SPEED_REPORT="$PWD/outputs/speed/report.json"
HIP_SPEED_HEAD_CHECKPOINT=""  # Use one fixed snapshot for paired comparisons.
HIP_SPEED_CANDIDATES="eager production"

# Optional authenticated model access. Leave blank unless needed.
HF_TOKEN=""
HF_HOME="$HIP_CLUSTER_ROOT/.cache/huggingface"
FAIRCHEM_CACHE_DIR="$HIP_CLUSTER_ROOT/.cache/fairchem"
